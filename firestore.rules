rules_version = '2';

// Hyber CRM security rules.
// - Every branch's data lives under branches/{branchId}; access needs an active
//   membership in that branch (or platform super admin).
// - There is no catch-all rule: a collection without a rule is closed.
// - Members are keyed by lower-cased Google email (branches/{b}/members/{email}).

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ identity

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(emailKey()));
    }

    function branchDoc(b) {
      return get(/databases/$(database)/documents/branches/$(b));
    }

    function memberPath(b) {
      return /databases/$(database)/documents/branches/$(b)/members/$(emailKey());
    }

    function member(b) {
      return get(memberPath(b)).data;
    }

    function isMember(b) {
      return signedIn()
        && exists(memberPath(b))
        && member(b).status == 'active'
        && branchDoc(b).data.status == 'active';
    }

    function hasRole(b, role) {
      return isMember(b) && role in member(b).roles;
    }

    function isAdmin(b) {
      return isSuperAdmin() || hasRole(b, 'admin');
    }

    function isTutor(b) {
      return hasRole(b, 'tutor');
    }

    function isStaff(b) {
      return isAdmin(b) || isTutor(b);
    }

    function isOwner(b) {
      return isSuperAdmin() || (hasRole(b, 'admin') && member(b).get('isOwner', false) == true);
    }

    function notRestricted(b, page) {
      return isSuperAdmin() || !(page in member(b).get('restrictions', []));
    }

    function myStaffId(b) {
      return member(b).get('staffId', null);
    }

    function myStudentId(b) {
      return member(b).get('studentId', null);
    }

    function myStudentIds(b) {
      return member(b).get('studentIds', []);
    }

    // -------------------------------------------------------------- helpers

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function stampedNow() {
      return request.resource.data.updatedAt == request.time;
    }

    // ------------------------------------------------------------ platform

    match /platformAdmins/{email} {
      allow read: if signedIn() && (email == emailKey() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isSuperAdmin());
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.email.lower() == emailKey();
      allow delete: if isSuperAdmin();
    }

    // "Which branches am I in?" — collection-group query on my own email.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.email == emailKey();
    }

    // "Which sign-up requests did I send?" — same pattern.
    match /{path=**}/signupRequests/{requestId} {
      allow read: if signedIn() && resource.data.email == emailKey();
    }

    // ------------------------------------------------------------- branches

    match /branches/{b} {
      allow read: if isSuperAdmin() || isMember(b);
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isAdmin(b)
            && changed().hasOnly(['name', 'shortName', 'timezone', 'locale', 'currency',
                                  'branding', 'contact', 'settings', 'updatedAt', 'updatedBy'])
            && stampedNow());

      // Public brand profile for the sign-up page and pickers.
      match /public/{docId} {
        allow read: if true;
        allow write: if isAdmin(b);
      }

      // ------------------------------------------------------ access

      match /members/{memberId} {
        function grantsAdmin(data) {
          return 'admin' in data.roles || data.get('isOwner', false) == true
            || data.get('restrictions', []).size() > 0;
        }

        function validMember(data) {
          return data.email == memberId
            && data.roles is list
            && data.roles.size() > 0
            && data.roles.hasOnly(['admin', 'tutor', 'parent', 'student'])
            && data.status in ['active', 'disabled'];
        }

        allow read: if isAdmin(b) || (signedIn() && memberId == emailKey());

        // Any admin manages tutors, parents and students; only owners manage admins.
        allow create: if isAdmin(b) && validMember(request.resource.data)
          && (isOwner(b) || !grantsAdmin(request.resource.data));

        allow update: if (isAdmin(b) && validMember(request.resource.data)
            && (isOwner(b) || (!grantsAdmin(resource.data) && !grantsAdmin(request.resource.data))))
          // The person links their own Google account on sign-in.
          || (signedIn() && memberId == emailKey()
            && changed().hasOnly(['uid', 'displayName', 'photoURL', 'firstLoginAt', 'lastLoginAt'])
            && request.resource.data.uid == request.auth.uid);

        allow delete: if isAdmin(b)
          && (isOwner(b) || !grantsAdmin(resource.data))
          && (isSuperAdmin() || resource.data.get('isOwner', false) != true);
      }

      match /signupRequests/{email} {
        function signupOpen(role) {
          let profile = get(/databases/$(database)/documents/branches/$(b)/public/profile).data;
          return profile.signupEnabled == true && role in profile.signupRoles;
        }

        allow read: if isAdmin(b) || (signedIn() && email == emailKey());
        allow create: if signedIn() && email == emailKey()
          && request.resource.data.email == email
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && signupOpen(request.resource.data.requestedRole);
        allow update: if isAdmin(b)
          || (signedIn() && email == emailKey()
              && resource.data.status == 'pending'
              && request.resource.data.status == 'pending'
              && request.resource.data.uid == request.auth.uid
              && changed().hasOnly(['firstName', 'lastName', 'phone', 'message', 'studentNames',
                                    'requestedRole', 'photoURL', 'updatedAt'])
              && signupOpen(request.resource.data.requestedRole));
        allow delete: if isAdmin(b) || (signedIn() && email == emailKey());
      }

      // ------------------------------------------------------ people

      match /staff/{staffId} {
        allow read: if isAdmin(b) || (isTutor(b) && staffId == myStaffId(b));
        allow create, delete: if isAdmin(b);
        allow update: if isAdmin(b)
          || (isTutor(b) && staffId == myStaffId(b)
              && changed().hasOnly(['phone', 'dob', 'address', 'notificationPrefs', 'subjectIds', 'updatedAt', 'updatedBy']));

        match /private/{docId} {
          allow read: if (docId == 'compensation'
                          && ((isAdmin(b) && notRestricted(b, 'payRates'))
                              || (isTutor(b) && staffId == myStaffId(b))))
                      || (docId == 'notes' && isAdmin(b));
          allow write: if (docId == 'compensation' && isAdmin(b) && notRestricted(b, 'payRates'))
                       || (docId == 'notes' && isAdmin(b));
        }
      }

      match /students/{studentId} {
        allow read: if isStaff(b)
          || (hasRole(b, 'student') && studentId == myStudentId(b))
          || (hasRole(b, 'parent') && studentId in myStudentIds(b));
        allow create, delete: if isAdmin(b);
        // Tutors keep the School tab up to date.
        allow update: if isAdmin(b)
          || (isTutor(b) && changed().hasOnly(['schoolRecord', 'updatedAt', 'updatedBy']));

        // Contacts, parents, address, school login: admins only.
        match /private/{docId} {
          allow read, write: if isAdmin(b);
        }

        match /conferenceNotes/{noteId} {
          allow read, write: if isAdmin(b);
        }
      }

      // ------------------------------------------------------ catalogs

      match /subjectCategories/{id} {
        allow read: if isMember(b) || isSuperAdmin();
        allow write: if isAdmin(b);
      }

      match /subjects/{id} {
        allow read: if isMember(b) || isSuperAdmin();
        allow write: if isAdmin(b);
      }

      match /conferenceCategories/{id} {
        allow read: if isStaff(b);
        allow write: if isAdmin(b);
      }

      // ------------------------------------------------------ availability

      // Tutors can't touch days that start inside the lock window (or the lead time,
      // when the branch blocks late availability). Admins can change any day.
      function lockDays() {
        let a = branchDoc(b).data.get('settings', {}).get('availability', {});
        let lock = a.get('lockWindowDays', 7);
        let lead = a.get('leadTimeDays', 14);
        return a.get('leadTimeEnforcement', 'warn') == 'block' && lead > lock ? lead : lock;
      }

      function tutorMayEdit(data) {
        return data.dayStartAt is timestamp
          && data.dayStartAt > request.time + duration.value(lockDays(), 'd');
      }

      function validAvailability(docId, data) {
        let utcMidnight = timestamp.date(int(data.dateKey[0:4]), int(data.dateKey[5:7]), int(data.dateKey[8:10]));
        return docId == data.staffId + '_' + data.dateKey
          && data.ranges is list
          && data.dayStartAt is timestamp
          && data.dayStartAt > utcMidnight - duration.value(15, 'h')
          && data.dayStartAt < utcMidnight + duration.value(15, 'h');
      }

      match /availability/{docId} {
        allow read: if isAdmin(b) || (isTutor(b) && resource.data.staffId == myStaffId(b));
        allow create: if validAvailability(docId, request.resource.data)
          && (isAdmin(b)
              || (isTutor(b) && request.resource.data.staffId == myStaffId(b) && tutorMayEdit(request.resource.data)));
        allow update: if validAvailability(docId, request.resource.data)
          && (isAdmin(b)
              || (isTutor(b) && resource.data.staffId == myStaffId(b) && request.resource.data.staffId == myStaffId(b)
                  && tutorMayEdit(resource.data) && tutorMayEdit(request.resource.data)));
        allow delete: if isAdmin(b) || (isTutor(b) && resource.data.staffId == myStaffId(b) && tutorMayEdit(resource.data));
      }

      match /dayConfigs/{dateKey} {
        allow read: if isMember(b) || isSuperAdmin();
        allow write: if isAdmin(b);
      }

      // ------------------------------------------------------ schedule

      // Nobody edits a session once its day is over (dayEndAt = next local midnight).
      match /sessions/{sessionId} {
        function dayOpen(data) {
          return data.dayEndAt is timestamp && data.dayEndAt > request.time
            && data.dayEndAt <= data.startAt + duration.value(25, 'h')
            && data.dayEndAt > data.startAt;
        }

        allow read: if isAdmin(b)
          || (isTutor(b) && resource.data.tutorId == myStaffId(b))
          || (hasRole(b, 'student') && resource.data.studentId == myStudentId(b))
          || (hasRole(b, 'parent') && resource.data.studentId in myStudentIds(b));
        allow create: if isAdmin(b) && dayOpen(request.resource.data);
        allow update: if isAdmin(b) && dayOpen(resource.data) && dayOpen(request.resource.data);
        // Trashed sessions can be purged even after their day.
        allow delete: if isAdmin(b) && (dayOpen(resource.data) || resource.data.isDeleted == true);
      }

      match /events/{eventId} {
        allow read: if isStaff(b);
        allow write: if isAdmin(b);
      }

      // Master Schedule (weekly template)
      match /masterSessions/{id} {
        allow read, write: if isAdmin(b);
      }

      match /masterAvailability/{id} {
        allow read, write: if isAdmin(b);
      }

      match /masterDayConfigs/{id} {
        allow read, write: if isAdmin(b);
      }

      // ------------------------------------------------------ audit log

      match /auditLog/{entryId} {
        allow read: if isAdmin(b);
        allow create: if isStaff(b)
          && request.resource.data.actorEmail == emailKey()
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // Server-only collections.
      match /kioskPins/{id} {
        allow read, write: if false;
      }
    }
  }
}
