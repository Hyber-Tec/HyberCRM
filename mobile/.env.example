# Only for running Expo by hand (README.md, "Running it"): copy to .env.local (git-ignored) and restart
# `npx expo start`. The npm commands (npm run iphone, npm run iphone:sim and the rest) need no .env.local: they
# choose the practice copy or the real Hyber CRM themselves.
#
# Which copy the app talks to is never set here. In a development build, Expo gives the app this file's values over
# the ones a command sets, so a line here saying to use the local emulators would make `npm run iphone:sim:live`
# talk to the practice copy. To run by hand against the emulators, say so on the command line instead:
#   EXPO_PUBLIC_USE_EMULATORS=true npx expo start

# Where the phone reaches the computer running the emulators. Leave empty for the iOS Simulator (127.0.0.1)
# and the Android emulator (10.0.2.2); a real phone needs the computer's address on the network.
EXPO_PUBLIC_EMULATOR_HOST=

# Where the app's links to the website go, when not the live site (or, against the emulators,
# the website's local server on the computer above).
EXPO_PUBLIC_WEB_URL=
