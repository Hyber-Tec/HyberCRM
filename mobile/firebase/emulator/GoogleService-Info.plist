<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A stand-in for Firebase's GoogleService-Info.plist that works only against the local emulators
  (EXPO_PUBLIC_USE_EMULATORS=true). It names the project and holds no keys: the API key and app id
  are placeholders in the shape Firebase checks for. The real file goes in mobile/firebase/ (see README).
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>Ahybercrm-emulator-placeholder-key-0000</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.hybertec.hybercrm</string>
	<key>PROJECT_ID</key>
	<string>hyber-crm</string>
	<key>STORAGE_BUCKET</key>
	<string>hyber-crm.firebasestorage.app</string>
	<key>IS_ADS_ENABLED</key>
	<false></false>
	<key>IS_ANALYTICS_ENABLED</key>
	<false></false>
	<key>IS_APPINVITE_ENABLED</key>
	<true></true>
	<key>IS_GCM_ENABLED</key>
	<true></true>
	<key>IS_SIGNIN_ENABLED</key>
	<true></true>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
